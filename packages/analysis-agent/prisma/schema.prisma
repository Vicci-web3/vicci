// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Basic model for analysis results
model Analysis {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Analysis metadata
  type        String  // Type of analysis performed
  status      String  // Status of the analysis (pending, completed, failed)
  
  // Analysis data
  inputData   Json?   // Input data used for analysis
  resultData  Json?   // Results of the analysis
  
  // Error handling
  error       String? // Error message if analysis failed
  
  // Timestamps for analysis execution
  startedAt   DateTime?
  completedAt DateTime?
}

// You can add more models as needed for your specific analysis requirements 