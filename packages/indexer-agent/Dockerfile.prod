FROM node:23-alpine

WORKDIR /usr/src/app

# Install build dependencies
RUN apk add --no-cache git netcat-openbsd

# Install specific pnpm version globally
RUN npm install -g pnpm@9.15.5

# Copy workspace files
COPY package*.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/indexer-agent/package*.json ./packages/indexer-agent/

# Install dependencies
RUN pnpm install

# Copy source code and prisma
COPY packages/indexer-agent ./packages/indexer-agent

# Generate Prisma client, build graph client and TypeScript
RUN cd packages/indexer-agent && \
    npx prisma generate && \
    pnpm build:graph && \
    pnpm build

# Set production environment
ENV NODE_ENV=production

# Wait for Postgres and start
CMD ["sh", "-c", "until nc -z postgres 5432; do echo waiting for postgres; sleep 2; done; cd packages/indexer-agent && npx prisma migrate deploy && node dist/index.js"]
