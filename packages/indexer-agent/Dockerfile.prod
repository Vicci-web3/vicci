FROM node:23-alpine AS builder

WORKDIR /usr/src/app

# Install build dependencies
RUN apk add --no-cache git

# Install specific pnpm version globally
RUN npm install -g pnpm@9.15.5

# Copy workspace files first for better caching
COPY package*.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/indexer-agent/package*.json ./packages/indexer-agent/

# Install all dependencies for build
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/indexer-agent ./packages/indexer-agent

# Generate Prisma client, build GraphQL client, and compile TypeScript
RUN cd packages/indexer-agent && \
    pnpm prisma generate && \
    pnpm build:graph && \
    pnpm build

# Production stage
FROM node:23-alpine AS production

WORKDIR /usr/src/app

# Install production dependencies only
RUN apk add --no-cache git && \
    npm install -g pnpm@9.15.5

# Copy package files
COPY package*.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/indexer-agent/package*.json ./packages/indexer-agent/

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod

# Copy built application from builder
COPY --from=builder /usr/src/app/packages/indexer-agent/dist ./packages/indexer-agent/dist
COPY --from=builder /usr/src/app/packages/indexer-agent/prisma ./packages/indexer-agent/prisma
COPY --from=builder /usr/src/app/packages/indexer-agent/node_modules/.prisma ./packages/indexer-agent/node_modules/.prisma
COPY --from=builder /usr/src/app/packages/indexer-agent/.graphclient ./packages/indexer-agent/.graphclient

# Set production environment
ENV NODE_ENV=production

# Start the indexer agent
CMD ["pnpm", "--filter", "@vic/indexer-agent", "start:prod"]
