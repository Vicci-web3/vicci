{
  "name": "@vic/indexer-agent",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm db:init && tsx watch --clear-screen=false src/index.ts",
    "codegen": "graphclient build",
    "build": "tsc --noEmitOnError false",
    "build:graph": "graphclient build",
    "test": "jest",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "db:init": "pnpm prisma:generate && pnpm prisma:migrate",
    "db:push": "npx prisma db push",
    "start:prod": "pnpm db:init && node dist/index.js"
    
  },
  "dependencies": {
    "@graphql-mesh/cache-localforage": "^0.x",
    "@graphql-mesh/cross-helpers": "^0.x",
    "@graphql-mesh/graphql": "^0.x",
    "@graphql-mesh/http": "^0.x",
    "@graphql-mesh/merger-bare": "^0.104.15",
    "@graphql-mesh/merger-stitching": "^0.x",
    "@graphql-mesh/runtime": "^0.x",
    "@graphql-mesh/store": "^0.x",
    "@graphql-mesh/types": "^0.x",
    "@graphql-mesh/utils": "^0.x",
    "@graphql-tools/delegate": "^10.0.3",
    "@graphql-tools/wrap": "^10.0.1",
    "@graphql-yoga/plugin-persisted-operations": "^3.10.11",
    "@langchain/cohere": "^0.3.2",
    "@langchain/community": "^0.3.28",
    "@langchain/core": "^0.3.37",
    "@prisma/client": "^6.3.0",
    "@types/pg": "^8.11.11",
    "@whatwg-node/fetch": "^0.10.0",
    "amqplib": "^0.10.5",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "langchain": "^0.1.25",
    "pg": "^8.13.1",
    "tsx": "^4.7.1",
    "viem": "^2.22.19",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@graphprotocol/client-cli": "^3.0.7",
    "@types/amqplib": "^0.10.6",
    "@types/node": "^22.13.0",
    "prisma": "^6.3.0",
    "typescript": "~5.6.3"
  }
}