FROM node:23-alpine AS builder

WORKDIR /usr/src/app

# Install build dependencies
RUN apk add --no-cache git

# Install specific pnpm version globally
RUN npm install -g pnpm@9.15.5

# Copy workspace files first for better caching
COPY package*.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/web/package*.json ./packages/web/

# Install all dependencies for build
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/web ./packages/web

# Build the Next.js application
RUN cd packages/web && \
    NEXT_TELEMETRY_DISABLED=1 pnpm build

# Production stage
FROM node:23-alpine AS production

WORKDIR /usr/src/app

# Install production dependencies only
RUN apk add --no-cache git && \
    npm install -g pnpm@9.15.5

# Copy package files
COPY package*.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/web/package*.json ./packages/web/

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod

# Copy built application from builder
COPY --from=builder /usr/src/app/packages/web/.next ./packages/web/.next
COPY --from=builder /usr/src/app/packages/web/public ./packages/web/public
COPY --from=builder /usr/src/app/packages/web/next.config.mjs ./packages/web/

# Set production environment
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

# Start the Next.js production server
CMD ["pnpm", "--filter", "@vic/web", "start"]
