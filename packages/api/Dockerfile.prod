FROM node:23-alpine

WORKDIR /usr/src/app

# Install build dependencies
RUN apk add --no-cache git netcat-openbsd

# Install specific pnpm version globally
RUN npm install -g pnpm@9.15.5

# Copy workspace files
COPY package*.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/api/package*.json ./packages/api/

# Install dependencies
RUN pnpm install

# Copy source code and prisma
COPY packages/api ./packages/api

# Generate Prisma client
RUN cd packages/api && \
    npx prisma generate

# Set production environment
ENV NODE_ENV=production

# Wait for Postgres and start
CMD ["sh", "-c", "until nc -z postgres 5432; do echo waiting for postgres; sleep 2; done; cd packages/api && npx prisma migrate deploy && tsx src/server.ts"]